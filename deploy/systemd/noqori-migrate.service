[Unit]
Description=NOQORI SQLite migrations
Before=noqori-api.service noqori-worker.service
PartOf=noqori.target

[Service]
Type=oneshot
User=noqori
Group=noqori
WorkingDirectory=/opt/noqori/current
EnvironmentFile=/etc/noqori/noqori.env
ExecStartPre=/usr/bin/test -x /usr/bin/node
ExecStart=/usr/bin/node scripts/run-production-service.mjs migrate
RemainAfterExit=yes
StateDirectory=noqori
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/noqori
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=noqori.target
