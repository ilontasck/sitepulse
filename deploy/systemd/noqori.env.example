# Non-secret production runtime configuration.
# Set the real HTTPS origin on the host before starting the services.
PORT=3000
PUBLIC_ORIGIN=
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3001
PLAYWRIGHT_BROWSERS_PATH=/opt/noqori/shared/ms-playwright
REQUEST_BODY_LIMIT_BYTES=32768
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60
RENDERED_AUDIT_TIMEOUT_MS=45000
AUDIT_WORKER_POLL_INTERVAL_MS=500
AUDIT_JOB_LEASE_MS=30000
AUDIT_JOB_HEARTBEAT_MS=10000
AUTH_SCRYPT_MAX_CONCURRENCY=1
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=30
AUTH_GENERAL_RATE_LIMIT_WINDOW_MS=60000
AUTH_GENERAL_RATE_LIMIT_MAX=120
AUDIT_USER_RATE_LIMIT_WINDOW_MS=3600000
AUDIT_USER_RATE_LIMIT_MAX=10
TELEMETRY_ENABLED=true
