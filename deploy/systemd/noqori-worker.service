[Unit]
Description=NOQORI audit worker
After=network-online.target noqori-migrate.service
Wants=network-online.target
Requires=noqori-migrate.service
PartOf=noqori.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=noqori
Group=noqori
WorkingDirectory=/opt/noqori/current
EnvironmentFile=/etc/noqori/noqori.env
ExecStartPre=/usr/bin/test -x /usr/bin/node
ExecStart=/usr/bin/node scripts/run-production-service.mjs worker
ExecStartPost=/usr/bin/node scripts/check-service-health.mjs worker --wait
Restart=on-failure
RestartSec=5s
TimeoutStopSec=90s
KillMode=mixed
StateDirectory=noqori
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/noqori
RestrictSUIDSGID=true
LockPersonality=true
TasksMax=512
MemoryMax=2G
CPUQuota=200%
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=noqori.target
