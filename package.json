{
  "name": "sitepulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "setup": "sh ./setup.sh",
    "start": "node --env-file=.env server.mjs",
    "dev": "node --env-file=.env server.mjs",
    "test": "node --test",
    "test:unit": "node --test",
    "test:e2e": "playwright test",
    "test:all": "pnpm test && pnpm test:e2e",
    "reset-db": "node scripts/reset-db.mjs"
  },
  "engines": {
    "node": ">=22.19"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  },
  "dependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.1",
    "playwright": "1.61.1"
  }
}
